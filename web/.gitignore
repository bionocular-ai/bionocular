# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# next dev regenerates these on every run
/AGENTS.md
/CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts

# Allow lib directory
!src/lib/

# Local data
data/

# Seed SQL (proprietary curve data + local fixtures)
supabase/seed/
